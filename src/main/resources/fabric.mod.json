  "authors": [
    "BaconCakeFactory"
  ],
  "contact": {
    "sources": "https://github.com/david-stefan-hermann/dyed-resin"
  },
  "license": "MIT",
  "icon": "assets/dyedresin/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dyedresin.DyedResin"
    ],
    "client": [
      "dyedresin.DevSceneClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "bcfguidebooklib": ">=1.0.0",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
